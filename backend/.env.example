# Backend Environment Variables Example for Microsoft Dev Tunnels Deployment

# Port configuration (default: 5000)
PORT=5000

# CORS Allowed Origins
# Supports comma-separated origins (e.g. devtunnels URLs, localhost) or '*' for all origins.
ALLOWED_ORIGINS=https://skin-cancer-server-5173.inc1.devtunnels.ms,http://localhost:5173,http://localhost:3000,*

# Optional environment settings
FLASK_ENV=production
