# Python cache / artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual envs
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Dataset (local only)
data/

# Trained model weights and heavy outputs
backend/models/*.keras
backend/outputs/*
outputs/*

# Node and package artifacts
frontend/node_modules/

# Local temporary files
.badfiles.txt
.gitdifflocal.txt
.gitshowhead.txt

# Keep directory structure (allow placeholders if needed later)
!backend/models/.gitkeep
!backend/outputs/.gitkeep
!backend/outputs/plots/.gitkeep
!backend/outputs/metrics/.gitkeep
!backend/outputs/adversarial_examples/.gitkeep
!outputs/.gitkeep
